# ==========================================================
# Secure Financial Analysis Chatbot - Environment Variables
# ==========================================================

# Flask Environment: development, testing, or production
FLASK_ENV=development
DEBUG=True

# Cryptographic Keys (GENERATE STRONG SECRETS FOR PRODUCTION)
# Use e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-flask-secret-key-change-in-production-64bytes-min
JWT_SECRET_KEY=dev-insecure-jwt-secret-key-change-in-production-64bytes-min
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Database Configuration
# SQLite local file by default; For PostgreSQL, use:
# postgresql://user:password@localhost:5432/finchat_db
DATABASE_URL=sqlite:///financial_chatbot.db

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_AUTH=10 per minute

# Chatbot AI & Guardrails
ENABLE_STRICT_PROMPT_GUARD=True
MAX_CHAT_INPUT_LENGTH=500
